# ================================

# React JS / Node.js .gitignore

# Proper & Production Ready

# ================================

# ----------------

# Dependencies

# ----------------

node_modules/
.pnp/
.pnp.js

# ----------------

# Build outputs

# ----------------

build/
dist/
out/

# ----------------

# Environment variables

# ----------------

.env
.env.*
!.env.example

# ----------------

# Logs

# ----------------

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----------------

# Coverage

# ----------------

coverage/

# ----------------

# Cache

# ----------------

.eslintcache
.cache/
.parcel-cache/

# ----------------

# IDE / Editors

# ----------------

.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# ----------------

# OS generated files

# ----------------

.DS_Store
Thumbs.db

# ----------------

# Optional: lock files (comment out if needed)

# ----------------

# package-lock.json

# yarn.lock

# pnpm-lock.yaml

# ----------------

# Optional: test & misc

# ----------------

*.log
*.tmp
*.swp

# ----------------

# Firebase / Netlify / Vercel

# ----------------

.firebase/
.vercel/
.netlify/

# ----------------

# TypeScript

# ----------------

*.tsbuildinfo

# ================================

# End of .gitignore

# ================================
